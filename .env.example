# ==============================================================================
# OUD & AURA - RAZORPAY PAYMENT GATEWAY CONFIGURATION
# ==============================================================================
# IMPORTANT:
# 1. Copy this file to a new file named '.env' in the project root directory.
# 2. Add your Razorpay TEST MODE credentials below.
# 3. NEVER commit your actual '.env' file or Secret Key to Git.
#
# Where to find your Razorpay Test Credentials:
# - Log in to Razorpay Dashboard: https://dashboard.razorpay.com/
# - Switch toggle in header/left sidebar to "Test Mode"
# - Go to Account & Settings -> API Keys (under Developer Settings)
# - Click "Generate Test Key" (or copy existing Key Id and Key Secret)
# ==============================================================================

# Your Razorpay Test Key ID (starts with rzp_test_...)
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE

# Your Razorpay Test Key Secret (keep this strictly private)
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET_HERE

# Server Port (default 8080)
PORT=8080
